# Copy to .env and fill in real values: cp .env.example .env

# --- Database (Postgres via docker-compose) ---
DATABASE_URL=postgresql://localmart:localmart_dev_password@localhost:5432/localmart_dev

# --- API server ---
API_PORT=3001
LOG_LEVEL=debug
NODE_ENV=development

# --- Web frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Clerk auth (get keys from https://dashboard.clerk.com — create a free dev instance) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
