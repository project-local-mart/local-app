{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@localmart/web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api/",
      "framework": "hono",
      "entrypoint": "src/app.ts",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@localmart/api^..."
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
