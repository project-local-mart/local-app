    "drizzle-orm": "^0.30.0",
    "hono": "^4.3.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@localmart/config": "workspace:*",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
